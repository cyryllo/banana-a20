#!/bin/bash
# lemaker-lcd: wybor ekranu LeMaker na Banana Pro (Armbian)
#
# Uzycie:
#   sudo lemaker-lcd          pokazuje, ktory ekran jest wlaczony
#   sudo lemaker-lcd 7        wlacza ekran 7" (albo 5, 35)
#   sudo lemaker-lcd 7-hdmi   ekran 7" w wariancie do pracy razem z HDMI
#   sudo lemaker-lcd off      wylacza ekran LCD (zostaje HDMI)
#
# Zmiana dziala po ponownym uruchomieniu (sudo reboot).

set -euo pipefail

ENV_FILE=/boot/armbianEnv.txt
DTBO_DIR=/boot/overlay-user
PREFIX=bananapro-lemaker-lcd
EKRANY=(35 5 7 7-hdmi)
POCZATEK="# >>> lemaker-lcd"
KONIEC="# <<< lemaker-lcd"

blad() {
	echo "BLAD: $*" >&2
	exit 1
}

# CO: zwraca nakladki z aktywnych (niezakomentowanych) linii user_overlays=.
# DLACZEGO wszystkie linie: U-Boot bierze ostatnia, ale ktos mogl dopisac
# kilka recznie, wiec zbieramy wszystko, zeby nic nie zgubic.
aktywne_nakladki() {
	grep -E '^[[:space:]]*user_overlays=' "${ENV_FILE}" | sed 's/^[[:space:]]*user_overlays=//' | tr ' ' '\n' | grep -v '^$' || true
}

pokaz_stan() {
	local wlaczony
	wlaczony=$(aktywne_nakladki | grep "^${PREFIX}" | tail -1 || true)
	if [[ -z "${wlaczony}" ]]; then
		echo "Ekran LCD: wylaczony (tylko HDMI)"
	else
		echo "Ekran LCD: ${wlaczony#"${PREFIX}"} (${wlaczony})"
	fi
	echo "Dostepne: ${EKRANY[*]} off"
}

[[ -f "${ENV_FILE}" ]] || blad "brak ${ENV_FILE}"

if [[ $# -eq 0 ]]; then
	pokaz_stan
	exit 0
fi

wybor="$1"
case "${wybor}" in
	35 | 5 | 7 | 7-hdmi)
		[[ -f "${DTBO_DIR}/${PREFIX}${wybor}.dtbo" ]] || blad "brak ${DTBO_DIR}/${PREFIX}${wybor}.dtbo"
		;;
	off) ;;
	-h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	*) blad "nieznany ekran: ${wybor} (dostepne: ${EKRANY[*]} off)" ;;
esac

[[ $EUID -eq 0 ]] || blad "uruchom przez sudo"

# CO: nakladki spoza LeMaker (np. dodane przez armbian-add-overlay) zostaja.
# DLACZEGO: skrypt ma zmieniac tylko ekran, nie cudze ustawienia.
# DLACZEGO "|| true": gdy nie ma innych nakladek, grep -v nic nie znajduje
# i zwraca blad, a przy pipefail przerwalby skrypt bez komunikatu.
inne=$({ aktywne_nakladki | grep -v "^${PREFIX}" || true; } | tr '\n' ' ' | sed 's/ *$//')

nowe="${inne}"
if [[ "${wybor}" != "off" ]]; then
	nowe="${inne:+${inne} }${PREFIX}${wybor}"
fi

# CO: usuwa stary blok lemaker-lcd i wszystkie aktywne linie user_overlays=,
# potem dopisuje blok od nowa na koncu pliku.
# DLACZEGO od nowa: wtedy zawsze jest dokladnie jedna aktywna linia
# i komplet zakomentowanych podpowiedzi dla recznej edycji.
cp "${ENV_FILE}" "${ENV_FILE}.bak"
tmp=$(mktemp)
sed -e "/^${POCZATEK}\$/,/^${KONIEC}\$/d" -e '/^[[:space:]]*user_overlays=/d' "${ENV_FILE}" > "${tmp}"
{
	echo "${POCZATEK}"
	echo "# LeMaker LCD: uncomment ONE line below (or run: sudo lemaker-lcd 35|5|7|7-hdmi|off)"
	for e in "${EKRANY[@]}"; do
		if [[ "${e}" == "${wybor}" ]]; then
			echo "user_overlays=${nowe}"
		elif [[ -n "${inne}" ]]; then
			echo "#user_overlays=${inne} ${PREFIX}${e}"
		else
			echo "#user_overlays=${PREFIX}${e}"
		fi
	done
	if [[ "${wybor}" == "off" && -n "${inne}" ]]; then
		echo "user_overlays=${inne}"
	fi
	echo "${KONIEC}"
} >> "${tmp}"
cat "${tmp}" > "${ENV_FILE}"
rm -f "${tmp}"

# CO: przy ekranach dobranych pod HDMI (5", 7-hdmi) wymusza HDMI 1920x1080,
# jesli uzytkownik nie ustawil juz wlasnego trybu HDMI (video=HDMI-A-1).
# DLACZEGO: LCD i HDMI dziela zegar PLL3. Zegary 29.7 MHz (5") i 42.429 MHz
# (7-hdmi) pasuja do 297 MHz, ktorego HDMI uzywa tylko w trybach 1080p/720p.
# Inne tryby HDMI (np. 1024x768) przestawilyby PLL3 i LCD znowu by migal.
# Bez podlaczonego HDMI ten parametr nic nie zmienia, wiec go nie usuwamy.
case "${wybor}" in
	5 | 7-hdmi)
		if ! grep -q '^extraargs=.*video=HDMI-A-1' "${ENV_FILE}"; then
			if grep -q '^extraargs=' "${ENV_FILE}"; then
				sed -i 's/^extraargs=.*/& video=HDMI-A-1:1920x1080@60/' "${ENV_FILE}"
			else
				echo "extraargs=video=HDMI-A-1:1920x1080@60" >> "${ENV_FILE}"
			fi
			echo "HDMI ustawione na 1920x1080 (extraargs w ${ENV_FILE})"
		fi
		;;
esac

pokaz_stan
echo "Uruchom ponownie, zeby zmiana zadzialala: sudo reboot"
